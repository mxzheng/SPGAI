---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Secure and Private System Design for Generative & Agentic AI" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <style>
      .tab-section {
        display: none;
      }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <slot />
<script>
  window.showSection = function(id) {
    document.querySelectorAll('.tab-section').forEach(s => {
      s.style.display = 'none';
    });
    document.querySelectorAll('.nav-item').forEach(n => {
      n.classList.remove('text-primary-600', 'font-semibold');
      n.classList.add('text-gray-600');
    });
    const target = document.getElementById(id);
    if (target) target.style.display = 'block';
    document.querySelectorAll(`.nav-item[data-section="${id}"]`).forEach(activeNav => {
      activeNav.classList.add('text-primary-600', 'font-semibold');
      activeNav.classList.remove('text-gray-600');
    });
  }

  function sectionFromHash() {
    const hash = window.location.hash.replace('#', '');
    const el = hash ? document.getElementById(hash) : null;
    return (el && el.classList.contains('tab-section')) ? hash : 'about';
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Open the section named in the URL hash, or About by default
    window.showSection(sectionFromHash());

    document.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', () => {
        const section = item.getAttribute('data-section');
        if (section) window.showSection(section);
        // no preventDefault: let the browser update the URL hash
      });
    });

    // Handle back/forward buttons and hash edits
    window.addEventListener('hashchange', () => {
      window.showSection(sectionFromHash());
    });

    document.getElementById('menu-toggle')?.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });
    document.querySelectorAll('#mobile-menu a').forEach(link => {
      link.addEventListener('click', () => {
        document.getElementById('mobile-menu')?.classList.add('hidden');
      });
    });
    document.querySelectorAll('.animate-on-scroll').forEach(el => {
      el.classList.add('animate-fade-in');
    });
  });
</script>
  </body>
</html>
